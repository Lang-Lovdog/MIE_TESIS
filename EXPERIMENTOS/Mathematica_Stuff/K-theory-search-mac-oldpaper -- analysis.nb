 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "In", " ", "this", " ", "part", " ", "the", " ", "NMinimize", " ", 
     "method", " ", "is", " ", "setup", " ", "for", " ", "the", " ", 
     "optimization", "\[IndentingNewLine]", "500", " ", "epochs", " ", "and", 
     " ", "40", " ", "decimal"}], "-", 
