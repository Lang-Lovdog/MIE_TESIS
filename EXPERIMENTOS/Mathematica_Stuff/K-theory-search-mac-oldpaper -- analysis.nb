Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "In", " ", "this", " ", "part", " ", "the", " ", "NMinimize", " ", 
     "method", " ", "is", " ", "setup", " ", "for", " ", "the", " ", 
     "optimization", "\[IndentingNewLine]", "500", " ", "epochs", " ", "and", 
     " ", "40", " ", "decimal"}], "-", 
    RowBox[{"precision", " ", "in", " ", "the", " ", "computations"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "NMinimize", " ", "search", " ", "a", " ", "global", " ", "minimum", " ", 
     "based", " ", "on", " ", "the", " ", "function"}], ",", " ", 
    RowBox[{
    "the", " ", "variables", " ", "and", " ", "the", " ", "constrains"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SetOptions", "[", 
     RowBox[{"NMinimize", ",", 
      RowBox[{"MaxIterations", "\[Rule]", "500"}], ",", 
      RowBox[{"WorkingPrecision", "\[Rule]", "40"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Table", " ", "inicialization", " ", 
      RowBox[{"for", " ", "'"}], 
      RowBox[{"max", "'"}], " ", "record"}], ",", " ", 
     RowBox[{"0", " ", "as", " ", "default", " ", "value"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"max", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "max"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
   "print", "[", "\"\<Creaci\[OAcute]n de Tabla y l\[IAcute]mite de \
iteraciones\>\"", "]"}], 
