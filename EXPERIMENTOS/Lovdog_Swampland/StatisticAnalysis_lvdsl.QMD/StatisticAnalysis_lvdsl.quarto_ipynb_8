        "Stable vacua count"
      ],
      "id": "6f930586"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 1. Prepare the Data\n",
        "plot_list = []\n",
        "for i, ds in enumerate(data):\n",
        "    model_num = i // 3\n",
        "    run_idx = i % 3  # 0, 1, or 2\n",
        "    stable_count = ds[ds['taquiónico'] == 0].shape[0]\n",
        "    \n",
        "    # Mapping indices to names for the plot\n",
        "    run_names = ['Run 1', 'Run 2', 'Run 3']\n",
        "    \n",
        "    plot_list.append({\n",
        "        'Model': f'Model {model_num + 1}',\n",
        "        'Run': run_names[run_idx],\n",
        "        'Stable_Count': stable_count,\n",
        "        'Total_Count': ds.shape[0]\n",
        "    })\n",
        "\n",
        "df_plot = pd.DataFrame(plot_list)\n",
        "\n",
        "# 2. Define the Autumn Forest Palette (Per Run)\n",
        "# Forest Green, Burnt Orange, Earthy Brown\n",
        "autumn_palette = [\"#228B22\", \"#D2691E\", \"#8B4513\"]\n",
        "\n",
        "# 3. Plotting\n",
        "plt.figure(figsize=(12, 7))\n",
        "\n",
        "ax = sns.barplot(\n",
        "    data=df_plot, \n",
        "    x='Model', \n",
        "    y='Stable_Count', \n",
        "    hue='Run', \n",
        "    palette=autumn_palette,\n",
        "    edgecolor='black'\n",
        ")\n",
        "\n",
        "# Aesthetics\n",
        "plt.title('Stability Analysis: Count of Non-Tachyonic Vacua', fontsize=14, fontweight='bold')\n",
        "plt.ylabel('Number of Stable (Non Tachionic) Points', fontsize=12)\n",
        "plt.xlabel('Model Comparison', fontsize=12)\n",
        "plt.ylim(0, 105) # Since you have 100 rows per dataset\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.3)\n",
        "\n",
        "# Legend placement\n",
        "plt.legend(title=\"Execution Runs\", loc='upper left', bbox_to_anchor=(1, 1))\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig('StabilityAnalysis.eps')\n",
        "plt.show()"
