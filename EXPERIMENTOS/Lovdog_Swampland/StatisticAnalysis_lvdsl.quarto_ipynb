   "metadata": {},
   "outputs": [],
   "source": [
    "lvdsl_output=[\n",
    "  ## Primer modelo\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174039/GA/GA-0000.csv.csv\",\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174039/GA/GA-0001.csv.csv\",\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174039/GA/GA-0002.csv.csv\",\n",
    "  ## Segundo modelo\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174049/GA/GA-0000.csv.csv\",\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174049/GA/GA-0001.csv.csv\",\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174049/GA/GA-0002.csv.csv\",\n",
    "  ## Tercer modelo\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174804/GA/GA-0000.csv.csv\",\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174804/GA/GA-0001.csv.csv\",\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_174804/GA/GA-0002.csv.csv\",\n",
    "  ## Cuarto modelo\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_175255/GA/GA-0000.csv.csv\",\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_175255/GA/GA-0001.csv.csv\",\n",
    "  \"./lvdsl_outputs/VacuaFound_07052026_175255/GA/GA-0002.csv.csv\",\n",
    "]\n",
    "\n",
    "data=[]\n",
    "\n",
    "for dataset in lvdsl_output:\n",
    "  data.append(pd.read_csv(dataset))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "37321aed",
   "metadata": {},
   "source": [
    "by Model grouping"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "7cb7f85b",
   "metadata": {},
   "outputs": [],
   "source": [
    "all_frames = []\n",
    "\n",
    "for i, path in enumerate(lvdsl_output):\n",
    "    df = pd.read_csv(path)\n",
    "    # Assign model group (0-2 is Model 1, 3-5 is Model 2, etc.)\n",
    "    df['Model'] = f'Model {i // 3 + 1}'\n",
    "    # Assign Run ID (0, 1, or 2 within that model)\n",
    "    df['Run'] = f'Run {i % 3}'\n",
    "    all_frames.append(df[['V', 'fitness', 'Model', 'Run']])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d391a48b",
   "metadata": {},
   "source": [
    "Stable vacua count"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "6ac5da33",
   "metadata": {},
   "outputs": [],
   "source": [
    "i=0\n",
    "for ds in data:\n",
    "  run = i\n",
    "  stable=ds[ds['taquiónico']==1].shape[0]\n",
    "  unstable=ds[ds['taquiónico']==0].shape[0]"
   ]
  },
