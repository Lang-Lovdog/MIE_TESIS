Cell[CellGroupData[{

Cell["Machine learning", "Subsection",
 CellChangeTimes->{{3.8450295752492237`*^9, 
  3.845029582389449*^9}},ExpressionUUID->"edcd0b12-4518-4ff1-807a-\
64d1a914184f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"datag", "=", 
     RowBox[{
     "Get", "[", 
      "\"\</Users/cesar/Dropbox/Source-codes/penalty-random-o3g-F5\>\"", 
      "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"up", "=", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{
       "datag", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}],
       "-", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"varsNN", "=", 
     RowBox[{"{", 
      RowBox[{"AF3", ",", "AH3", ",", "AD5", ",", "AO3", ",", "AF5"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"dataNNv", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Chop", "[", 
        RowBox[{"(", 
         RowBox[{"varsNN", "/.", 
          RowBox[{
           RowBox[{
           "datag", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}], 
           "\[LeftDoubleBracket]", 
           RowBox[{"2", ";;", "up"}], "\[RightDoubleBracket]"}]}], ")"}], 
        "]"}], "\[Rule]", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{
         "datag", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}], 
         "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"jj", ",", "1", ",", 
        RowBox[{"Length", "[", "datag", "]"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frac", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nvs2tes", ",", "nvs2tra"}], "}"}], "=", 
     RowBox[{"TakeDrop", "[", 
      RowBox[{"dataNNv", ",", 
       RowBox[{"Round", "[", 
        RowBox[{"frac", "*", 
         RowBox[{"Length", "[", "dataNNv", "]"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"net", "=", 
     RowBox[{"NetChain", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"32", ",", "Tanh", ",", "1"}], "}"}], ",", 
       RowBox[{"\"\<Input\>\"", "\[Rule]", " ", 
        RowBox[{"{", "5", "}"}]}], ",", 
       RowBox[{"\"\<Output\>\"", "\[Rule]", "\"\<Scalar\>\""}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"net", "=", 
     RowBox[{"NetInitialize", "[", "net", "]"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"trainedv", "=", 
    RowBox[{"NetTrain", "[", 
     RowBox[{"net", ",", "nvs2tra", ",", 
      RowBox[{"ValidationSet", "\[Rule]", "nvs2tes"}], ",", 
      RowBox[{"TargetDevice", "->", "\"\<CPU\>\""}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"net", "=", 
      RowBox[{"NetChain", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"45", ",", "Tanh", ",", "1"}], "}"}], ",", 
        RowBox[{"\"\<Input\>\"", "\[Rule]", "6"}], ",", 
        RowBox[{"\"\<Output\>\"", "\[Rule]", "\"\<Scalar\>\""}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"traineds", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NetTrain", "[", 
         RowBox[{"net", ",", "dataNNs", ",", 
          RowBox[{"Method", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"\"\<ADAM\>\"", ",", 
             RowBox[{"\"\<L2Regularization\>\"", "\[Rule]", "0.005"}]}], 
            "}"}]}]}], "]"}], "\[IndentingNewLine]", "net"}], "=", 
       RowBox[{"NetChain", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"32", ",", "Tanh", ",", "1"}], "}"}], ",", 
         RowBox[{"\"\<Input\>\"", "\[Rule]", "6"}], ",", 
         RowBox[{"\"\<Output\>\"", "\[Rule]", "\"\<Scalar\>\""}]}], "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"trained\[Tau]", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NetTrain", "[", 
         RowBox[{"net", ",", "dataNN\[Tau]", ",", 
          RowBox[{"Method", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"\"\<ADAM\>\"", ",", 
             RowBox[{"\"\<L2Regularization\>\"", "\[Rule]", "0.005"}]}], 
            "}"}]}]}], "]"}], "\[IndentingNewLine]", "net"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"NetChain", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"32", ",", "Tanh", ",", "1"}], "}"}], ",", 
           RowBox[{"\"\<Input\>\"", "\[Rule]", "6"}], ",", 
           RowBox[{"\"\<Output\>\"", "\[Rule]", "1"}]}], "]"}], 
         "\[IndentingNewLine]", "net1"}], "=", 
        RowBox[{"NetTrain", "[", 
         RowBox[{"net", ",", "dataNN", ",", 
          RowBox[{"BatchSize", "\[Rule]", "1024"}]}], "]"}]}]}]}]}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.843127918017277*^9, 3.843128166932406*^9}, 
