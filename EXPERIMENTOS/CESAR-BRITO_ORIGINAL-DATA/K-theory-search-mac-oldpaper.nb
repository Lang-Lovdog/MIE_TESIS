Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "+", 
       RowBox[{"2", "y"}], "-", "7"}], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "x"}], "+", "y", "-", "5"}], ")"}], "2"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "20"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "0.2"}], 
       SqrtBox[
        RowBox[{"0.5", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "+", 
           SuperscriptBox["y", "2"]}], ")"}]}]]}], "]"}]}], "-", 
    RowBox[{"Exp", "[", 
     RowBox[{"0.5", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], "+", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "\[Pi]", " ", "y"}], "]"}]}], ")"}]}], "]"}], "+", 
    
    RowBox[{"Exp", "[", "1", "]"}], "+", "20"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"min", ",", "steps"}], "}"}], "=", 
   RowBox[{"Reap", "[", "\[IndentingNewLine]", 
    RowBox[{"NMinimize", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
