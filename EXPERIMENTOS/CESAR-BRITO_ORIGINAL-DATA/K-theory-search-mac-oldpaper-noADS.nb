Cell[BoxData[
 RowBox[{"NDSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{
         SuperscriptBox["\[Tau]p", "\[Prime]",
          MultilineFunction->None], "[", "s", "]"}]}], "+", 
       RowBox[{"s", " ", 
        RowBox[{
         SuperscriptBox["\[Tau]p", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "s", "]"}]}]}], "\[Equal]", 
      RowBox[{"s", " ", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"\[Tau]p", "[", "s", "]"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            FractionBox["AF5", 
             SuperscriptBox[
              RowBox[{"\[Tau]p", "[", "s", "]"}], "4"]], "+", 
            FractionBox["AO3", 
             SuperscriptBox[
              RowBox[{"\[Tau]p", "[", "s", "]"}], "3"]], "+", 
            FractionBox["AF3", 
             RowBox[{"s", " ", 
              SuperscriptBox[
               RowBox[{"\[Tau]p", "[", "s", "]"}], "3"]}]], "+", 
            FractionBox[
             RowBox[{"AH3", " ", "s"}], 
             SuperscriptBox[
              RowBox[{"\[Tau]p", "[", "s", "]"}], "3"]]}], "/.", 
           "\[VeryThinSpace]", 
           RowBox[{
            RowBox[{"Symbol", "[", "]"}], "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}]}], "/.", "\[VeryThinSpace]", 
          RowBox[{
           RowBox[{"Symbol", "[", "]"}], "\[LeftDoubleBracket]", 
           RowBox[{"4", ";;", "0"}], "\[RightDoubleBracket]"}]}], ")"}]}]}]}],
      ",", 
     RowBox[{
      RowBox[{"\[Tau]p", "[", "100", "]"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{"\[Tau]", "/.", "\[VeryThinSpace]", 
        RowBox[{"2", ";;", "3"}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Tau]p", "\[Prime]",
        MultilineFunction->None], "[", 
       FractionBox["1", "1000"], "]"}], "\[Equal]", "0.`"}]}], "}"}], ",", 
   RowBox[{"\[Tau]p", "[", "s", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "1", ",", "1000"}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{{3.855668601320065*^9, 3.8556687386030607`*^9}, 
   3.8556687711127367`*^9, {3.855668827537504*^9, 3.855668962628669*^9}, {
   3.8556689973873034`*^9, 3.855669014856402*^9}, {3.8556690477721443`*^9, 
   3.855669105571013*^9}, 3.855669550733576*^9, 3.9783607462228775`*^9},
 CellLabel->
