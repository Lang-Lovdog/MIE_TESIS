Cell["Calibration", "Section",
 CellChangeTimes->{{3.8390652197923203`*^9, 
  3.8390652563829823`*^9}},ExpressionUUID->"330632bc-da7c-4ddc-a8f9-\
8c95dc46b439"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"var", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NM", "=", 
    RowBox[{"Length", "[", "var", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mij", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"var", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
         ",", 
        RowBox[{
        "var", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "NM"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "NM"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diV", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{
        "var", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "NM"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{
        "var", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       "]"}], "\[Equal]", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", "var"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pfun", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]1", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"#1", "<", "0"}], ",", 
        SuperscriptBox["#1", "2"], ",", "0"}], "]"}]}], "+", 
     RowBox[{"\[Alpha]2", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"#2", "<", "0"}], ",", 
        SuperscriptBox["#2", "2"], ",", "0"}], "]"}]}]}], " ", "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"NMinimize", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], ",", 
   RowBox[{"Method", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<SimulatedAnnealing\>\"", ",", 
      RowBox[{"\"\<PenaltyFunction\>\"", "\[Rule]", "pfun"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.837786530735375*^9, 3.8377867929584017`*^9}, 
