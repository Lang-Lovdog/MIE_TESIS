Cell[BoxData[
 TemplateBox[{
  "NMinimize", "precw", 
   "\"The precision of the argument function (\\!\\(\\*RowBox[{\\\"20\\\", \\\
\"+\\\", \\\"\[ExponentialE]\\\", \\\"-\\\", RowBox[{\\\"20\\\", \\\" \\\", \
SuperscriptBox[\\\"\[ExponentialE]\\\", RowBox[{RowBox[{\\\"-\\\", \
\\\"0.14142135623730953`\\\"}], \\\" \\\", \
SqrtBox[RowBox[{SuperscriptBox[\\\"x\\\", \\\"2\\\"], \\\"+\\\", \
SuperscriptBox[\\\"y\\\", \\\"2\\\"]}]]}]]}], \\\"-\\\", SuperscriptBox[\\\"\
\[ExponentialE]\\\", RowBox[{\\\"0.5`\\\", \\\" \\\", RowBox[{\\\"(\\\", \
RowBox[{RowBox[{\\\"Cos\\\", \\\"[\\\", RowBox[{\\\"2\\\", \\\" \\\", \\\"\
\[Pi]\\\", \\\" \\\", \\\"x\\\"}], \\\"]\\\"}], \\\"+\\\", \
RowBox[{\\\"Cos\\\", \\\"[\\\", RowBox[{\\\"2\\\", \\\" \\\", \\\"\[Pi]\\\", \
\\\" \\\", \\\"y\\\"}], \\\"]\\\"}]}], \\\")\\\"}]}]]}]\\)) is less than \
WorkingPrecision (\\!\\(\\*RowBox[{\\\"40\\\"}]\\)).\"", 2, 185, 162, 
   30875437396980916158, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
