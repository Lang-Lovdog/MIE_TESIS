Cell["Intento 2", "Section",
 CellChangeTimes->{{3.841787639547859*^9, 
  3.841787649654179*^9}},ExpressionUUID->"a75e1898-a0d9-4b61-add4-\
16fa9d11acad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"changmoduli", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Tau]", "\[Rule]", 
        RowBox[{
         SuperscriptBox["E", 
          RowBox[{"-", "\[Phi]"}]], 
         SuperscriptBox["vol", 
          RowBox[{"1", "/", "2"}]]}]}], ",", 
       RowBox[{"\[Rho]", "\[Rule]", 
        SuperscriptBox["vol", 
         RowBox[{"1", "/", "3"}]]}]}], "}"}], "/.", 
     RowBox[{"{", 
      RowBox[{"vol", " ", "\[Rule]", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Tau]", " ", 
          RowBox[{"Exp", "[", "\[Phi]", "]"}]}], ")"}], 
        RowBox[{"3", "/", "2"}]]}], "}"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VH3", "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"AH3", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"2", "\[Phi]"}], "]"}]}], 
      SuperscriptBox["\[Rho]", "6"]], "/.", "changmoduli"}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", "->", 
      RowBox[{"Log", "[", 
       FractionBox["1", "s"], "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VF3", "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"AF3", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"4", " ", "\[Phi]"}], "]"}]}], 
      SuperscriptBox["\[Rho]", "6"]], "/.", "changmoduli"}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", "->", 
      RowBox[{"Log", "[", 
       FractionBox["1", "s"], "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VR6", "=", 
   RowBox[{"AR6", " ", 
    RowBox[{"PowerExpand", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Rho]", 
         RowBox[{"-", "1"}]], 
        SuperscriptBox["\[Tau]", 
         RowBox[{"-", "2"}]]}], ")"}], "/.", "changmoduli"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VD5", "=", 
   FractionBox["AD5", 
    RowBox[{
     SqrtBox["s"], " ", 
     SuperscriptBox["\[Tau]", 
      RowBox[{"5", "/", "2"}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vreal", "=", 
   RowBox[{"VH3", "+", "VF3", "+", "VR6", "+", "VD5"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"var", "=", 
   RowBox[{"{", 
    RowBox[{"s", ",", "\[Tau]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NM", "=", 
   RowBox[{"Length", "[", "var", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mij", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"Vreal", ",", 
        RowBox[{"var", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
         ",", 
        RowBox[{
        "var", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "NM"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "NM"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diV", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"Vreal", ",", 
        RowBox[{
        "var", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "NM"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"egval", "=", 
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"Vreal", ",", 
        RowBox[{"var", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
         ",", 
        RowBox[{
        "var", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pfun", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", ",", "\[Tau]"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "egval", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "<",
          "0"}], ",", "1000", ",", "0"}], "]"}], "+", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "egval", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "<",
          "0"}], ",", "1000", ",", "0"}], "]"}], "+", 
      FractionBox["100", 
       RowBox[{"s", "+", "1"}]], "+", 
      FractionBox[
       RowBox[{"100", " "}], 
       RowBox[{"\[Tau]", "+", "1"}]], "+", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Vreal", "<", "0"}], ",", "1000", ",", "0"}], "]"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"NMinimize", ",", 
    RowBox[{"AccuracyGoal", "\[Rule]", " ", "0.001"}], ",", 
    RowBox[{"MaxIterations", "\[Rule]", "500"}], ",", 
    RowBox[{"WorkingPrecision", "\[Rule]", "40"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"max", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "max"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"invalue", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"20", ",", "200"}], "}"}], "]"}], ",", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"20", ",", "200"}], "}"}], "]"}], ",", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}], ",", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}], ",", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}], ",", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", "50"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"min", ",", "steps"}], "}"}], "=", 
     RowBox[{"Reap", "[", "\[IndentingNewLine]", 
      RowBox[{"NMinimize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{
              "diV", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "2"], "+", 
             SuperscriptBox[
              RowBox[{
              "diV", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "2"]}], ")"}], "+", 
           RowBox[{"10", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
               "egval", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}], "]"}], "-", 
              RowBox[{
              "egval", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], ")"}]}], "+", 
           RowBox[{"10", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
               "egval", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}], "]"}], "-", 
              RowBox[{
              "egval", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], ")"}]}], "+", 
           FractionBox["100", 
            RowBox[{"s", "+", "1"}]], "+", 
           FractionBox[
            RowBox[{"100", " "}], 
            RowBox[{"\[Tau]", "+", "1"}]], "+", " ", 
           RowBox[{"10", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", "Vreal", "]"}], "-", "Vreal"}], ")"}]}]}], ",", 
          RowBox[{"s", ">", "5"}], ",", 
          RowBox[{"\[Tau]", ">", "taur"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "s", ",", "\[Tau]", ",", "AF3", ",", "AH3", ",", "AD5", ",", "AR6"}],
          "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<SimulatedAnnealing\>\"", ",", 
           RowBox[{"\"\<PerturbationScale\>\"", "\[Rule]", "2.5"}], ",", 
           RowBox[{"\"\<LevelIterations\>\"", "\[Rule]", "200"}], ",", 
           RowBox[{"\"\<SearchPoints\>\"", "\[Rule]", "Automatic"}], ",", 
           RowBox[{"\"\<InitialPoints\>\"", "\[Rule]", "invalue"}], ",", 
           RowBox[{"\"\<PostProcess\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"FindMinimum", ",", 
              RowBox[{"Method", "\[Rule]", "\"\<ConjugateGradient\>\""}], ",", 
              RowBox[{"MaxIterations", "\[Rule]", " ", "500"}], ",", 
              RowBox[{"PrecisionGoal", "\[Rule]", 
               SuperscriptBox["10", 
                RowBox[{"-", "3"}]]}], ",", 
              RowBox[{"WorkingPrecision", "\[Rule]", 
               SuperscriptBox["10", "3"]}]}], "}"}]}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"StepMonitor", "\[RuleDelayed]", 
         RowBox[{"Sow", "[", 
          RowBox[{"{", 
           RowBox[{
           "s", ",", "\[Tau]", ",", "AF3", ",", "AH3", ",", "AD5", ",", 
            "AR6"}], "}"}], "]"}]}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"min", ",", "steps"}], "}"}], "=", 
       RowBox[{"Reap", "[", "\[IndentingNewLine]", 
        RowBox[{"NMinimize", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Vreal", ",", 
            RowBox[{"s", ">", "1.1"}], ",", 
            RowBox[{"\[Tau]", ">", "2.1"}], ",", 
            RowBox[{
            "diV", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "diV", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "s", ",", "\[Tau]", ",", "AF3", ",", "AH3", ",", "AD5", ",", 
            "AR6"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Method", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"\"\<SimulatedAnnealing\>\"", ",", 
             RowBox[{"\"\<PerturbationScale\>\"", "\[Rule]", "1.5"}], ",", 
             RowBox[{"\"\<LevelIterations\>\"", "\[Rule]", "100"}], ",", 
             RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "10"}], ",", 
             RowBox[{"\"\<PenaltyFunction\>\"", "\[Rule]", "pfun"}], ",", 
             RowBox[{"\"\<PostProcess\>\"", "\[Rule]", "Automatic"}]}], 
            "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"StepMonitor", "\[RuleDelayed]", 
           RowBox[{"Sow", "[", 
            RowBox[{"{", 
             RowBox[{
             "s", ",", "\[Tau]", ",", "AF3", ",", "AH3", ",", "AD5", ",", 
              "AR6"}], "}"}], "]"}]}]}], "]"}], "]"}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"ll", "=", 
     RowBox[{"Length", "[", 
      RowBox[{"steps", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
       "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"pp", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "steps", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]",
            "i", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "1", 
          "\[RightDoubleBracket]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "steps", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]",
            "i", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "2", 
          "\[RightDoubleBracket]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "ll"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"taur", ",", "400"}], "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<_______________________________________________________ \
taur = \>\"", ",", "taur"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<min = \>\"", ",", 
         RowBox[{"N", "[", 
          RowBox[{"min", ",", "10"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<diV = \>\"", ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Simplify", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"Vreal", ",", 
                 RowBox[{
                 "var", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "NM"}], "}"}]}], "]"}], "]"}], "/.", 
            RowBox[{
            "min", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",",
            "10"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SuperscriptBox[\(m\), \(2\)]\) = \>\"", ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"egval", "/.", 
            RowBox[{
            "min", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",",
            "10"}], "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "data", "\[LeftDoubleBracket]", "taur", "\[RightDoubleBracket]"}], "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "min", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          
          RowBox[{
          "min", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
          
          RowBox[{"egval", "/.", 
           RowBox[{
           "min", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
         "}"}], ",", "10"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"taur", ",", "1", ",", "max"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
