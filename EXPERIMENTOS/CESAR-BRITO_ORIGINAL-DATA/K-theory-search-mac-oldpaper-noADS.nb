Cell[BoxData[{
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"FindRoot", ",", 
    RowBox[{"MaxIterations", "\[Rule]", " ", "500"}], ",", 
    RowBox[{"Compiled", "\[Rule]", "False"}], ",", 
    RowBox[{"WorkingPrecision", "\[Rule]", "1000"}], ",", 
    RowBox[{"Method", "\[Rule]", " ", "Automatic"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$MaxExtraPrecision", "=", "10000"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datag", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "max"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fr", "=", 
      RowBox[{"Quiet", "@", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"diV", "/.", 
          RowBox[{
           RowBox[{
           "data", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
           RowBox[{"4", ";;", "10"}], "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"s", "/.", 
              RowBox[{
               RowBox[{
               "data", "\[LeftDoubleBracket]", "jj", 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "2", 
               "\[RightDoubleBracket]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Tau]", ",", 
             RowBox[{"\[Tau]", "/.", 
              RowBox[{
               RowBox[{
               "data", "\[LeftDoubleBracket]", "jj", 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "3", 
               "\[RightDoubleBracket]"}]}]}], "}"}]}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"diV", "/.", 
           RowBox[{
            RowBox[{
            "data", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
            RowBox[{"4", ";;", "10"}], "\[RightDoubleBracket]"}]}], "/.", 
          "fr"}], "]"}], "\[Equal]", "0."}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Print", 
          "[", "\"\<----------------------------------------------------------\
----------------------------------\>\"", "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"datag", "[", 
          RowBox[{"[", "jj", "]"}], "]"}], "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Vreal", "/.", "fr"}], "/.", 
               RowBox[{
                RowBox[{
                "data", "\[LeftDoubleBracket]", "jj", 
                 "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
                RowBox[{"4", ";;", "10"}], "\[RightDoubleBracket]"}]}], ",", 
              "fr", ",", 
              RowBox[{
               RowBox[{
               "data", "\[LeftDoubleBracket]", "jj", 
                "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
               RowBox[{"4", ";;", "10"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{
               RowBox[{"egval", "/.", "fr"}], "/.", 
               RowBox[{
                RowBox[{
