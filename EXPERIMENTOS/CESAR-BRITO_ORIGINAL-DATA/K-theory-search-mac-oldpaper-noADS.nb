Cell[BoxData[
 RowBox[{"NMinimize", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], ",", 
   RowBox[{"Method", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"SimulatedAnnealing\"\>", ",", 
      RowBox[{"\<\"PenaltyFunction\"\>", "\[Rule]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]1", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#1", "<", "0"}], ",", 
             SuperscriptBox["#1", "2"], ",", "0"}], "]"}]}], "+", 
          RowBox[{"\[Alpha]2", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#2", "<", "0"}], ",", 
             SuperscriptBox["#2", "2"], ",", "0"}], "]"}]}]}], "&"}], 
        ")"}]}]}], "}"}]}]}], "]"}]], "Output",
