   RowBox[{"{", 
    RowBox[{"\[Phi]", "->", 
     RowBox[{"Log", "[", 
      FractionBox["1", "s"], "]"}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"VO3", "=", 
