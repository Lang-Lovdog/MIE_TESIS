Cell[BoxData[{
 RowBox[{
  RowBox[{"changmoduli", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Tau]", "\[Rule]", 
